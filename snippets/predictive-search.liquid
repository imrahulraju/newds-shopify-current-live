<div class="search-panel" id="SearchPanel">
  <div class="search-wrap">
    <div class="search-bar">
      <form action="/search" class="search-form">
        <span class="search-ico">{% render 'icon', icon: 'search' %}</span>
        <input id="SearchInput" name="q" placeholder="Search necklaces, rings, bracelets…" autocomplete="off" aria-label="Search products">
        <button class="icon-btn" type="button" data-search-close aria-label="Close search">×</button>
      </form>
      <div id="SearchResults" class="search-drop" hidden></div>
    </div>
  </div>
</div>
