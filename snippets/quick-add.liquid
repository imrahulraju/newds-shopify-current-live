<script>document.addEventListener('click',async e=>{const b=e.target.closest('[data-quick-add]');if(!b)return;const id=parseInt(b.getAttribute('data-quick-add'));if(!id)return;const html=b.innerHTML;b.textContent='...';try{await Cart.add(id,1)}catch(err){if(!err||err.message!=='add-rejected')location.href='/cart'};b.innerHTML=html;});</script>