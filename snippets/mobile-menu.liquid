<div
  id="mobile-menu"
  class="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  tabindex="-1"
  hidden
>
  <div class="mobile-menu__overlay" data-mobile-menu-close tabindex="-1"></div>
  <div class="mobile-menu__panel">

    <!-- Header -->
    <div class="mobile-menu__header">
      <button
        class="mobile-menu__close btn-reset"
        aria-label="Close menu"
        data-mobile-menu-close
      >
        {%- render 'icon', icon: 'close' -%}
      </button>
    </div>

    <!-- Nav Items -->
    <nav class="mobile-menu__nav" role="navigation">
      <ul class="mobile-menu__list list-reset">

        <li class="mobile-menu__item">
          <a href="{{ routes.root_url }}" class="mobile-menu__link">HOME</a>
        </li>

        <li class="mobile-menu__item mobile-menu__item--accordion">
          <button class="mobile-menu__link mobile-menu__accordion-trigger btn-reset" aria-expanded="false">
            SHOP
            <span class="mobile-menu__chevron" aria-hidden="true">
              {%- render 'icon', icon: 'chevron-down' -%}
            </span>
          </button>
          <ul class="mobile-menu__submenu list-reset" hidden>
            <li><a href="{{ routes.collections_url }}" class="mobile-menu__sublink">All Products</a></li>
            <li><a href="/collections/anklets" class="mobile-menu__sublink">Anklets</a></li>
            <li><a href="/collections/bracelets" class="mobile-menu__sublink">Bracelets</a></li>
            <li><a href="/collections/earring" class="mobile-menu__sublink">Earring</a></li>
            <li><a href="/collections/neck-chains" class="mobile-menu__sublink">Neck Chains</a></li>
            <li><a href="/collections/rings" class="mobile-menu__sublink">Rings</a></li>
            <li><a href="/collections/wrist-bands" class="mobile-menu__sublink">Wrist Bands</a></li>
          </ul>
        </li>

        <li class="mobile-menu__item">
          <a href="/collections/new-arrivals" class="mobile-menu__link">NEW ARRIVALS</a>
        </li>

        <li class="mobile-menu__item">
          <a href="/pages/contact" class="mobile-menu__link">CONTACT US</a>
        </li>

        <li class="mobile-menu__item mobile-menu__item--accordion">
          <button class="mobile-menu__link mobile-menu__accordion-trigger btn-reset" aria-expanded="false">
            OUR POLICIES
            <span class="mobile-menu__chevron" aria-hidden="true">
              {%- render 'icon', icon: 'chevron-down' -%}
            </span>
          </button>
          <ul class="mobile-menu__submenu list-reset" hidden>
            <li><a href="/policies/privacy-policy" class="mobile-menu__sublink">Privacy Policy</a></li>
            <li><a href="/policies/refund-policy" class="mobile-menu__sublink">Return Policy</a></li>
            <li><a href="/policies/shipping-policy" class="mobile-menu__sublink">Shipping Policy</a></li>
            <li><a href="/policies/terms-of-service" class="mobile-menu__sublink">Terms and Conditions</a></li>
          </ul>
        </li>

      </ul>
    </nav>

    <!-- Additional Links -->
    <div class="mobile-menu__additional">
      <a href="/pages/size-guide" class="mobile-menu__additional-link">Size Guide</a>
      <a href="/pages/jewellery-care" class="mobile-menu__additional-link">Jewellery Care</a>
      <a href="/pages/faq" class="mobile-menu__additional-link">FAQ's</a>
      <a href="/policies/terms-of-service" class="mobile-menu__additional-link">Terms and Conditions</a>
      {%- if customer -%}
        <a href="{{ routes.account_url }}" class="mobile-menu__additional-link">My Account</a>
      {%- else -%}
        <a href="{{ routes.account_login_url }}" class="mobile-menu__additional-link">Login</a>
      {%- endif -%}
    </div>

    <!-- Social -->
    <div class="mobile-menu__social">
      <a
        href="https://www.instagram.com/newds.co"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-menu__social-link"
        aria-label="Follow on Instagram"
      >
        {%- render 'icon', icon: 'instagram' -%}
        <span>@newds.co</span>
      </a>
    </div>

  </div>
</div>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__overlay {
    position: absolute;
    inset: 0;
    background: transparent;
  }

  .mobile-menu__panel {
    position: relative;
    width: 100%;
    max-width: 100vw;
    height: 100vh;
    background: #FFFFFF;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    padding-bottom: 80px;
  }

  .mobile-menu.is-open .mobile-menu__panel {
    transform: translateX(0);
  }

  .mobile-menu__header {
    display: flex;
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid #E8E3DE;
  }

  .mobile-menu__close {
    display: flex;
    align-items: center;
    color: #8F7967;
    cursor: pointer;
    transition: opacity 0.25s ease;
  }

  .mobile-menu__close:hover {
    opacity: 0.7;
  }

  .mobile-menu__nav {
    flex: 1;
  }

  .mobile-menu__list {
    padding: 0;
  }

  .mobile-menu__item {
    border-bottom: 1px solid #E8E3DE;
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 25px 24px;
    font-size: 26px;
    letter-spacing: 2px;
    color: #8F7967;
    text-decoration: none;
    font-weight: 400;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    transition: opacity 0.25s ease;
  }

  .mobile-menu__link:hover {
    opacity: 0.7;
  }

  .mobile-menu__chevron {
    display: flex;
    align-items: center;
    transition: transform 0.25s ease;
  }

  .mobile-menu__accordion-trigger[aria-expanded="true"] .mobile-menu__chevron {
    transform: rotate(180deg);
  }

  .mobile-menu__submenu {
    background: #FDFCFB;
    border-top: 1px solid #E8E3DE;
  }

  .mobile-menu__submenu[hidden] {
    display: none;
  }

  .mobile-menu__sublink {
    display: block;
    padding: 14px 32px;
    font-size: 14px;
    letter-spacing: 1px;
    color: #8C8178;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.25s ease;
  }

  .mobile-menu__sublink:hover {
    opacity: 0.7;
  }

  .mobile-menu__additional {
    padding: 24px;
    border-top: 1px solid #E8E3DE;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mobile-menu__additional-link {
    font-size: 12px;
    letter-spacing: 1px;
    color: #9B8878;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.25s ease;
  }

  .mobile-menu__additional-link:hover {
    opacity: 0.7;
  }

  .mobile-menu__social {
    padding: 24px;
    border-top: 1px solid #E8E3DE;
  }

  .mobile-menu__social-link {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #8F7967;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 1px;
    transition: opacity 0.25s ease;
  }

  .mobile-menu__social-link:hover {
    opacity: 0.7;
  }
</style>
