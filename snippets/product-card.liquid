<div class="p-card reveal" data-filter-title="{{ product.title | escape }}" data-filter-type="{{ product.type | escape }}" data-filter-tags="{{ product.tags | join: '|' | escape }}" data-filter-variants="{{ product.variants | map: 'title' | join: '|' | escape }}">
<a href="{{ product.url }}" class="p-media">
<span class="p-track">{% for img in product.images limit: 4 %}<img src="{{ img | image_url: width: 600 }}" width="600" height="600" alt="{{ product.title | escape }}" loading="lazy">{% endfor %}</span>
{% if product.metafields.custom.badge %}<span class="p-badge">{{ product.metafields.custom.badge }}</span>{% elsif product.compare_at_price > product.price %}<span class="p-badge">Sale</span>{% endif %}
</a>
<div class="p-utils">
{% if product.images.size > 1 %}<span class="p-dots">{% for img in product.images limit: 4 %}<i class="{% if forloop.first %}on{% endif %}"></i>{% endfor %}</span>{% else %}<span class="p-dots"></span>{% endif %}
{% if product.has_only_default_variant %}<button class="p-add" data-quick-add="{{ product.selected_or_first_available_variant.id }}">{% render 'icon', icon: 'cart' %} ADD</button>{% else %}<a class="p-add" href="{{ product.url }}">{% render 'icon', icon: 'cart' %} ADD</a>{% endif %}
</div>
<div class="p-info"><a href="{{ product.url }}" class="p-name">{{ product.title | upcase }}</a><div class="p-price">{% render 'price', product: product %}</div></div>
</div>
