<div class="cart-page">
  {% render 'breadcrumbs' %}

  <div class="section-head">
    <h1 style="font-size:17px;letter-spacing:3px">YOUR CART</h1>
  </div>

  {% if cart.item_count > 0 %}
    {% form 'cart', cart %}
      <div style="display:grid;gap:16px">
        {% for item in cart.items %}
          <div
            class="cart-row"
            style="border:1px solid var(--border);padding:12px"
          >
            <img
              src="{{ item.image | image_url: width: 160 }}"
              width="160"
              height="160"
              alt="{{ item.title | escape }}"
            >

            <div>
              <div style="font-size:12px;letter-spacing:1px">
                {{ item.product.title | upcase }}
              </div>

              <div style="font-size:12px">
                {{ item.variant_title }}
                · ₹{{ item.final_price | money_without_currency }}
              </div>

              <div style="display:flex;gap:8px;margin-top:8px">
                <input
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  style="width:60px;border:1px solid var(--border);padding:6px"
                >

                <button
                  type="submit"
                  style="background:none;border:0;cursor:pointer;color:var(--primary);font-size:12px"
                >
                  Update
                </button>

                <a
                  href="{{ item.url_to_remove }}"
                  style="font-size:12px"
                >
                  Remove
                </a>
              </div>
            </div>

            <div>₹{{ item.final_line_price | money_without_currency }}</div>
          </div>
        {% endfor %}
      </div>

      <div style="text-align:right;margin-top:24px">
        <p>
          Subtotal:
          <strong> ₹{{ cart.total_price | money_without_currency }} </strong>
        </p>

        <!-- INTERNATIONAL SHIPPING AGREEMENT -->

        {% if localization.country.iso_code != 'IN' %}
          <div
            style="
              margin-top:20px;
              padding:16px;
              border:1px solid var(--border);
              text-align:left;
              background:#fafafa;
            "
          >
            <div
              style="
                font-size:14px;
                font-weight:600;
                margin-bottom:8px;
              "
            >
              International Shipping
            </div>

            <div
              style="
                font-size:13px;
                line-height:1.6;
                margin-bottom:14px;
              "
            >
              Shipping charges for orders outside India are not included in the order total. We will contact you after
              placing the order and inform you of the applicable shipping charges based on your country.
            </div>

            <label
              style="
                display:flex;
                gap:10px;
                align-items:flex-start;
                cursor:pointer;
                font-size:13px;
                line-height:1.5;
              "
            >
              <input
                type="checkbox"
                id="international-shipping-agreement"
                style="
                  width:18px;
                  height:18px;
                  margin:2px 0 0;
                  flex-shrink:0;
                "
              >

              <span> I agree to pay the applicable international shipping charges. </span>
            </label>

            <div
              id="international-shipping-error"
              style="
                display:none;
                color:#d00;
                font-size:12px;
                margin-top:10px;
              "
            >
              Please agree to the international shipping charges before proceeding to checkout.
            </div>
          </div>
        {% endif %}

        <!-- BUTTONS -->

        <div
          style="
            display:flex;
            gap:12px;
            justify-content:flex-end;
            margin-top:12px;
          "
        >
          <a
            href="/collections/all"
            class="btn"
          >
            Continue Shopping
          </a>

          <button
            type="submit"
            name="checkout"
            id="cart-checkout-button"
            class="btn btn--solid"
            style="width:auto;padding:0 40px"
          >
            Checkout
          </button>
        </div>
      </div>
    {% endform %}

  {% else %}
    <p style="text-align:center;padding:40px 0">
      Your cart is empty.
      <a
        href="/collections/all"
        style="text-decoration:underline"
      >
        Continue shopping
      </a>
    </p>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const checkbox = document.getElementById('international-shipping-agreement');

    const checkoutButton = document.getElementById('cart-checkout-button');

    const errorMessage = document.getElementById('international-shipping-error');

    /*
     * India:
     * No checkbox exists, so checkout works normally.
     */

    if (!checkbox || !checkoutButton) {
      return;
    }

    /*
     * International:
     * Require checkbox before checkout.
     */

    checkoutButton.addEventListener('click', function (event) {
      if (!checkbox.checked) {
        event.preventDefault();

        errorMessage.style.display = 'block';

        checkbox.focus();
      }
    });

    /*
     * Hide error after customer checks the box.
     */

    checkbox.addEventListener('change', function () {
      if (checkbox.checked) {
        errorMessage.style.display = 'none';
      }
    });
  });
</script>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
