<div class="cart-page" style="max-width:640px"><h1 class="coll-title" style="text-align:center">MY ACCOUNT</h1><p style="text-align:center;margin:16px 0">Hello, {{ customer.first_name }} (<a href="/account/logout" style="text-decoration:underline">Logout</a>)</p><h2 style="font-size:14px;margin:24px 0 12px">ORDER HISTORY</h2>{% paginate customer.orders by 10 %}{% if customer.orders.size > 0 %}{% for o in customer.orders %}<p style="border-bottom:1px solid var(--border);padding:10px 0">{{ o.name }} · {{ o.created_at | date: '%b %d, %Y' }} · ₹{{ o.total_price | money_without_currency }} · {{ o.fulfillment_status_label }}</p>{% endfor %}{% else %}<p>You haven't placed any orders yet.</p>{% endif %}{% endpaginate %}</div>
{% schema %}{"name":"Main account","settings":[]}{% endschema %}
