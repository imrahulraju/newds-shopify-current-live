<section class="section reveal" style="padding-top:8px"><div class="section-head has-filter"><div><h2>{{ section.settings.heading | default: 'NEW ARRIVALS' }}</h2><p class="f-list-count" style="font-size:12px;margin-top:6px"></p></div><button type="button" class="f-open-btn f-icon-only" data-filters-open aria-label="Open filters">{% render 'icon', icon: 'sliders' %}<span class="f-count FilterCountBadge" hidden></span></button></div>
<div class="carousel-wrap"><button class="car-btn prev" data-scroll="prev" aria-label="Previous">‹</button>
<div class="carousel">{% assign col = collections[section.settings.collection] %}
{% if col and col.products.size > 0 %}{% for p in col.products limit: section.settings.limit %}{% render 'product-card', product: p %}{% endfor %}
{% else %}{% for i in (1..5) %}<div class="p-card"><div class="p-media"><img src="https://newds.co.in/wp-content/uploads/2026/09/{{ section.settings.fallback_seed | default: '169EF90A-33C7-47CA-80BB-AA2CF1561ACF' }}-300x300.png" alt="Jewellery" loading="lazy" width="300" height="300" onerror="this.src='https://newds.co.in/wp-content/uploads/2026/06/00BF8F34-70EA-4ED7-91D0-C3AE20ABFB03-300x300.png'"></div><div class="p-info"><div class="p-name">Sample Piece {{ i }}</div><div class="p-price">₹499</div></div></div>{% endfor %}{% endif %}
</div><button class="car-btn next" data-scroll="next" aria-label="Next">›</button></div></section>
{% schema %}{"name":"Product carousel","settings":[{"type":"text","id":"heading","label":"Heading","default":"NEW ARRIVALS"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products to show","min":4,"max":12,"default":10},{"type":"text","id":"fallback_seed","label":"Fallback image seed (newds.co.in file id)"}],"presets":[{"name":"Product carousel"}]}{% endschema %}
