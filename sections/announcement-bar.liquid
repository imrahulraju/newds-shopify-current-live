{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "FREE SHIPPING ON ORDERS OVER ₹3799"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "INTERNATIONAL SHIPPING AVAILABLE"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Message 3",
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}

<div class="announcement-bar" role="region" aria-label="Announcement">
  <div class="announcement-bar__track">
    {%- assign messages = '' | split: '' -%}
    {%- if section.settings.message_1 != blank -%}
      {%- assign messages = messages | concat: section.settings.message_1 | split: '|||' -%}
    {%- endif -%}

    {%- assign all_messages = '' -%}
    {%- if section.settings.message_1 != blank -%}
      {%- assign all_messages = all_messages | append: section.settings.message_1 | append: '|||' -%}
    {%- endif -%}
    {%- if section.settings.message_2 != blank -%}
      {%- assign all_messages = all_messages | append: section.settings.message_2 | append: '|||' -%}
    {%- endif -%}
    {%- if section.settings.message_3 != blank -%}
      {%- assign all_messages = all_messages | append: section.settings.message_3 | append: '|||' -%}
    {%- endif -%}
    {%- assign message_list = all_messages | split: '|||' -%}

    <div class="announcement-bar__inner">
      {%- for i in (1..4) -%}
        {%- for message in message_list -%}
          {%- if message != blank -%}
            <span class="announcement-bar__item">{{ message }}</span>
            <span class="announcement-bar__separator" aria-hidden="true">✦</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .announcement-bar {
    height: 32px;
    background: #FFFFFF;
    border-top: 1px solid #EEEAE6;
    border-bottom: 1px solid #EEEAE6;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .announcement-bar__track {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    white-space: nowrap;
    animation: marquee 30s linear infinite;
  }

  .announcement-bar__item {
    font-size: 10px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #9A8776;
    padding: 0 24px;
    font-weight: 500;
    display: inline-block;
  }

  .announcement-bar__separator {
    color: #DED6CF;
    font-size: 8px;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__inner {
      animation: none;
    }
  }
</style>
