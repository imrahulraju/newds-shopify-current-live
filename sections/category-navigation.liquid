<section class="section reveal"><div class="section-head"><h2>{{ section.settings.heading | default: 'SHOP BY CATEGORY' }}</h2></div><div class="cat-grid">
{% assign fallbacks = 'https://newds.co.in/wp-content/uploads/2026/06/00BF8F34-70EA-4ED7-91D0-C3AE20ABFB03-300x300.png,https://newds.co.in/wp-content/uploads/2026/06/1ECC9F1D-C4BC-47BF-8F6F-109C520467AF-300x300.png,https://newds.co.in/wp-content/uploads/2026/06/4B1CE001-4A9D-4C00-A6E7-82CBEEC868AD-300x300.png,https://newds.co.in/wp-content/uploads/2026/09/06723C39-E0F8-474E-A2BC-E87CEBD55DBB-300x300.png,https://newds.co.in/wp-content/uploads/2026/09/0BBD8EB3-95B9-4C45-B9D3-FB2D399E0766-300x300.png,https://newds.co.in/wp-content/uploads/2026/09/0F805622-2CAB-4318-AEAD-A0511BD14EA5-300x300.png' | split: ',' %}
{% assign cats = 'Bracelets,Rings,Neck Chains,Earring,Wrist Bands,Anklets' | split: ',' %}
{% for c in cats %}{% assign h = c | handle %}{% assign col = collections[h] %}
<a class="cat-item" href="{% if col %}{{ col.url }}{% else %}/collections/{{ h }}{% endif %}"><span class="cat-circle">{% if col and col.image %}<img src="{{ col.image | image_url: width: 300 }}" width="300" height="300" alt="{{ c | escape }}" loading="lazy">{% else %}<img src="{{ fallbacks[forloop.index0] }}" width="300" height="300" alt="{{ c | escape }}" loading="lazy">{% endif %}</span>{{ c }}</a>{% endfor %}
</div></section>
{% schema %}{"name":"Category navigation","settings":[{"type":"text","id":"heading","label":"Heading","default":"SHOP BY CATEGORY"}],"presets":[{"name":"Category navigation"}]}{% endschema %}
