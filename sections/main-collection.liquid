<div class="coll-head"><div>{% render 'breadcrumbs' %}<h1 class="coll-title">{{ collection.title | upcase }}</h1><p style="font-size:12px;margin-top:6px">{{ collection.products_count }} products</p></div>
<div class="coll-tools"><label for="SortBy" style="font-size:11px;letter-spacing:1px">SORT</label><select id="SortBy">{% assign s = collection.sort_by | default: collection.default_sort_by %}<option value="manual" {% if s == 'manual' %}selected{% endif %}>Featured</option><option value="price-ascending" {% if s == 'price-ascending' %}selected{% endif %}>Price: Low to High</option><option value="price-descending" {% if s == 'price-descending' %}selected{% endif %}>Price: High to Low</option><option value="created-descending" {% if s == 'created-descending' %}selected{% endif %}>Newest</option><option value="best-selling" {% if s == 'best-selling' %}selected{% endif %}>Best Selling</option></select></div></div>
{% paginate collection.products by 12 %}
<div class="prod-grid">{% for p in collection.products %}{% render 'product-card', product: p %}{% endfor %}</div>
{% render 'pagination', paginate: paginate %}
{% endpaginate %}
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
