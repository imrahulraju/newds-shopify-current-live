<section class="hero-banner"><div class="page-width"><div class="hero reveal">
<div class="hero-content"><h1>{{ section.settings.heading | default: 'Luxury Jewellery for the Modern You' }}</h1><p>{{ section.settings.sub | default: 'Waterproof · Sweat Proof · Hypoallergenic' }}</p><a href="{{ section.settings.link | default: '/collections/all' }}" class="btn">{{ section.settings.btn | default: 'Shop Now' }}</a></div>
<div class="hero-media">{% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 1200 }}" width="1200" height="375" alt="{{ section.settings.heading | escape }}" loading="eager" fetchpriority="high">{% else %}<img class="ph" src="https://newds.co.in/wp-content/uploads/2026/06/image-836-1-1024x660.png" width="1024" height="660" alt="NEWDS.CO jewellery" loading="eager">{% endif %}</div>
</div></div></section>
{% schema %}{"name":"Hero banner","settings":[{"type":"text","id":"heading","label":"Heading","default":"Luxury Jewellery for the Modern You"},{"type":"text","id":"sub","label":"Subheading","default":"Waterproof · Sweat Proof · Hypoallergenic"},{"type":"text","id":"btn","label":"Button text","default":"Shop Now"},{"type":"url","id":"link","label":"Button link"},{"type":"image_picker","id":"image","label":"Hero image (right)"}],"presets":[{"name":"Hero banner"}]}{% endschema %}
