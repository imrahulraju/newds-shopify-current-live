<div class="cart-page" style="max-width:420px"><h1 class="coll-title" style="text-align:center">LOGIN</h1><div style="margin-top:20px">{% form 'customer_login' %}{{ form.errors | default_errors }}<input type="email" name="customer[email]" placeholder="Email" style="width:100%;border:1px solid var(--border);padding:12px;margin-bottom:12px"><input type="password" name="customer[password]" placeholder="Password" style="width:100%;border:1px solid var(--border);padding:12px;margin-bottom:12px"><button class="btn btn--solid" type="submit">Sign In</button><p style="text-align:center;margin-top:12px;font-size:12px"><a href="/account/register">Create account</a> · <a href="/account/recover">Forgot password?</a></p>{% endform %}</div></div>
{% schema %}{"name":"Main login","settings":[]}{% endschema %}
