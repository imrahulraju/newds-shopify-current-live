<div class="coll-head"><div>{% render 'breadcrumbs' %}<h1 class="coll-title">SEARCH{% if search.terms %} — {{ search.terms | upcase }}{% endif %}</h1><p style="font-size:12px;margin-top:6px">{{ search.results_count }} results</p></div></div>
{% paginate search.results by 12 %}<div class="prod-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}
{% schema %}{"name":"Main search","settings":[]}{% endschema %}
