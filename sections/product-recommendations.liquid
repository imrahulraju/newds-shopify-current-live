{% if recommendations.performed %}
{% if recommendations.products_count > 0 %}<section class="section"><div class="section-head"><div><h2>{{ section.settings.heading | default: 'RELATED PRODUCTS' }}</h2></div></div><div class="carousel-wrap"><div class="carousel">{% for p in recommendations.products limit: 8 %}{% render 'product-card', product: p %}{% endfor %}</div></div></section>{% endif %}
{% else %}
{% assign src_col = product.collections.first %}
{% if src_col and src_col.products.size > 1 %}<section class="section"><div class="section-head"><div><h2>{{ section.settings.heading | default: 'RELATED PRODUCTS' }}</h2></div></div><div class="carousel-wrap"><div class="carousel">{% for p in src_col.products %}{% if p.id != product.id and p.available %}{% render 'product-card', product: p %}{% endif %}{% endfor %}{% for p in src_col.products %}{% if p.id != product.id and p.available == false %}{% render 'product-card', product: p %}{% endif %}{% endfor %}</div></div></section>{% endif %}
{% endif %}
{% schema %}{"name":"Product recommendations","settings":[{"type":"text","id":"heading","label":"Heading","default":"RELATED PRODUCTS"}]}{% endschema %}
