{% assign rec = recommendations.products %}{% if rec.size > 0 %}<section class="section"><div class="section-head has-filter"><div><h2>{{ section.settings.heading | default: 'RELATED PRODUCTS' }}</h2><p class="f-list-count" style="font-size:12px;margin-top:6px"></p></div><button type="button" class="f-open-btn f-icon-only" data-filters-open aria-label="Open filters">{% render 'icon', icon: 'sliders' %}<span class="f-count FilterCountBadge" hidden></span></button></div><div class="carousel-wrap"><div class="carousel">{% for p in rec limit: 8 %}{% render 'product-card', product: p %}{% endfor %}</div></div></section>{% endif %}
{% schema %}{"name":"Product recommendations","settings":[{"type":"text","id":"heading","label":"Heading","default":"RELATED PRODUCTS"}]}{% endschema %}
