<section class="section contact reveal" style="max-width:720px;margin:0 auto;text-align:center">
<h2>{{ section.settings.heading | default: 'CONTACT US' }}</h2>
<p class="sub">{{ section.settings.sub | default: '@newds.co' }}</p>
<p>{{ section.settings.p1 | default: "DM us on Instagram for quick responses. We're here to help! For any queries related to orders, returns, or product information, feel free to reach out to us via Instagram. Our team typically responds within 24 hours." }}</p>
<a href="https://instagram.com/newds.co" class="btn" style="margin-top:16px">Message on Instagram</a>
<div style="margin-top:32px">
<h3 style="font-size:13px;letter-spacing:3px">OUR ADDRESS</h3>
<p style="margin-top:8px">Newds.Co<br>123, MG Road, Koramangala<br>Bangalore, Karnataka - 560034<br>India</p>
<p style="margin-top:8px;font-size:12px">newds.co@gmail.com</p>
</div>
</section>
{% schema %}{"name":"Contact section","settings":[{"type":"text","id":"heading","label":"Heading","default":"CONTACT US"},{"type":"text","id":"sub","label":"Subheading","default":"@newds.co"},{"type":"textarea","id":"p1","label":"Intro text"}],"presets":[{"name":"Contact section"}]}{% endschema %}
