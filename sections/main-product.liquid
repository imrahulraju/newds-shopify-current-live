{% render 'breadcrumbs' %}
<div class="pdp"><div class="pdp-gallery">
<div class="main" id="PdpMainWrap"><img id="PdpMain" src="{{ product.featured_image | image_url: width: 900 }}" width="900" height="900" alt="{{ product.title | escape }}" draggable="false">
<button type="button" class="gal-icon gal-zoom" id="PdpZoom" aria-label="Zoom image"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg></button>
<button type="button" class="gal-icon gal-share" id="PdpShare" aria-label="Share product"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6"/></svg></button>
{% if product.images.size > 1 %}<div class="gal-dots" id="PdpDots">{% for img in product.images limit: 6 %}<button type="button" data-index="{{ forloop.index0 }}" class="{% if forloop.first %}on{% endif %}" aria-label="View image {{ forloop.index }}"></button>{% endfor %}</div><span class="gal-count" id="PdpCount">1 / {{ product.images.size }}</span>{% endif %}
</div>
<div class="pdp-thumbs">{% for img in product.images limit: 6 %}<button class="{% if forloop.first %}on{% endif %}" data-src="{{ img | image_url: width: 900 }}" data-full="{{ img | image_url: width: 1600 }}" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}"><img src="{{ img | image_url: width: 120 }}" width="120" height="120" alt="{{ product.title | escape }}" loading="lazy"></button>{% endfor %}</div>
<div class="gal-lightbox" id="PdpLightbox" hidden><button type="button" class="gal-lb-close" id="PdpLbClose" aria-label="Close zoom">×</button><img id="PdpZoomImg" src="" alt="Zoomed product image"></div>
</div><div class="pdp-info">
<h1>{{ product.title | upcase }}</h1>
<div class="pdp-price">{% render 'price', product: product %}</div>
{% if product.metafields.custom.badge %}<span class="p-badge" style="position:static">{{ product.metafields.custom.badge }}</span>{% endif %}
{% form 'product', product, id: 'ProductForm' %}
<input type="hidden" name="id" id="VariantId" value="{{ product.selected_or_first_available_variant.id }}">
<script type="application/json" id="VariantData">{{ product.variants | json }}</script>
{% unless product.has_only_default_variant %}
{% for opt in product.options_with_values %}<div class="variant-label">{{ opt.name | upcase }}{% if opt.name == 'Size' or opt.name == 'size' %}<a data-modal="SizeModal">Size Guide</a>{% endif %}</div>
<div class="variants">{% for v in opt.values %}<button type="button" class="variant {% if opt.selected_value == v %}on{% endif %}" data-option="option{{ opt.position }}" data-value="{{ v | escape }}">{{ v }}</button>{% endfor %}</div>{% endfor %}
{% endunless %}
<div class="variant-label">QUANTITY</div><div class="qty"><button type="button" data-qty="minus">−</button>{% assign _v = product.selected_or_first_available_variant %}<input name="quantity" id="PdpQty" value="1" min="1" max="{% if _v.inventory_management and _v.inventory_policy == 'deny' %}{{ _v.inventory_quantity }}{% else %}99{% endif %}"><button type="button" data-qty="plus">+</button></div>
<div id="StockNote" style="font-size:12px;margin-top:6px"></div>
<div id="Avail">{% if product.available %}<span class="stock-in">● In Stock</span>{% else %}<span class="stock-out">● Out of Stock</span>{% endif %}</div>
{% assign pdp_in_cart = false %}{% for item in cart.items %}{% if item.variant_id == product.selected_or_first_available_variant.id %}{% assign pdp_in_cart = true %}{% endif %}{% endfor %}
<button type="submit" id="PdpCta" data-product-id="{{ product.id }}" data-mode="{% if pdp_in_cart %}view{% else %}add{% endif %}" class="btn btn--solid" style="margin-top:14px" {% unless product.available %}disabled{% endunless %}>{% if pdp_in_cart %}View Cart{% else %}Add to Cart{% endif %}</button>
<div class="cart-success" id="CartOk">✓ Added to cart successfully</div>
{% endform %}
<div class="pdp-meta">
<details open><summary>DESCRIPTION</summary><div style="margin-top:8px">{{ product.description }}</div></details>
{% assign pdp_coll = blank %}{% if collection and collection.description != blank and collection.handle != 'all' and collection.handle != 'frontpage' %}{% assign pdp_coll = collection %}{% else %}{% for c in product.collections %}{% if c.description != blank and c.handle != 'all' and c.handle != 'frontpage' %}{% assign pdp_coll = c %}{% break %}{% endif %}{% endfor %}{% endif %}
{% if pdp_coll != blank %}<details><summary>ABOUT {{ pdp_coll.title | upcase }}</summary><div style="margin-top:8px">{{ pdp_coll.description }}</div></details>{% endif %}
{% if product.metafields.custom.care_instructions %}<details><summary>JEWELLERY CARE</summary><div style="margin-top:8px">{{ product.metafields.custom.care_instructions }}</div></details>{% endif %}
{% if product.metafields.custom.product_features %}<details><summary>FEATURES</summary><div style="margin-top:8px">{{ product.metafields.custom.product_features | join: '<br>' }}</div></details>{% endif %}
<details><summary>SHIPPING & RETURNS</summary><div style="margin-top:8px">Free shipping on orders over ₹3799. 30-day easy returns.</div></details>
</div></div></div>
<div class="modal" id="SizeModal"><div class="modal-box"><button data-modal-close style="position:absolute;top:12px;right:14px;background:none;border:0;font-size:18px;cursor:pointer">×</button><h3>SIZE GUIDE</h3>{% if product.metafields.custom.size_guide %}{{ product.metafields.custom.size_guide }}{% else %}<table><tr><th>Size</th><th>Inner Dia (mm)</th></tr><tr><td>6</td><td>16.5</td></tr><tr><td>7</td><td>17.3</td></tr><tr><td>8</td><td>18.1</td></tr></table>{% endif %}</div></div>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}
