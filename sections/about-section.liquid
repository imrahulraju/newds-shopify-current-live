<section class="section about reveal"><h2>{{ section.settings.heading | default: 'WHO WE ARE' }}</h2><p class="sub">{{ section.settings.sub | default: 'ELEVATE YOUR STYLE WITH NEWDS.CO' }}</p>
<p>{{ section.settings.p1 | default: 'Newds.Co is a premier online jewellery destination, offering exquisite and affordable pieces to adorn your life. Our mission is to provide exceptional quality, stylish designs, and outstanding customer service.' }}</p>
<p>{{ section.settings.p2 | default: "From elegant necklaces to chic earrings, sophisticated cuffs to stunning rings, our extensive range has something for everyone. Whether you're looking for a special gift or treating yourself, Newds.Co is your ultimate jewellery haven." }}</p>
<a href="{{ section.settings.link | default: '/collections/all' }}" class="btn" style="margin-top:16px">{{ section.settings.btn | default: 'Shop Now' }}</a></section>
{% schema %}{"name":"About section","settings":[{"type":"text","id":"heading","label":"Heading","default":"WHO WE ARE"},{"type":"text","id":"sub","label":"Subheading","default":"ELEVATE YOUR STYLE WITH NEWDS.CO"},{"type":"textarea","id":"p1","label":"Paragraph 1"},{"type":"textarea","id":"p2","label":"Paragraph 2"},{"type":"text","id":"btn","label":"Button text","default":"Shop Now"},{"type":"url","id":"link","label":"Button link"}],"presets":[{"name":"About section"}]}{% endschema %}
