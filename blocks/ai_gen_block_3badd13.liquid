{% doc %}
  @prompt
    Size Guide
    Find your perfect fit with our sizing chart.
    
    Bangles
    Size	Recommended Fit
    2.2	Thin / Slim Wrists
    2.4	Medium Wrists
    2.6	Standard / Regular Fit
    2.8	Broader / Larger Wrists
    Rings
    Size	Recommended Fit
    6	Slimmer Fingers
    7	Medium Fingers
    8	Broader Fingers
    Some ring designs are adjustable at the back, making them ideal for gifting or if you’re unsure of the exact size.
    
    Necklaces
    Double Layer Necklace
    Measurement	Length
    First Layer	35–38 cm
    Second Layer	40–45 cm
    Extension Chain	5 cm
    Single Layer Necklace
    Measurement	Length
    Chain Length	40–44 cm
    Extension Chain	5 cm
    Chain Bracelets
    Standard Size
    Measurement	Length
    Bracelet Length	15–18 cm
    Extension Chain	3.5 cm
    Kids Size
    Measurement	Length
    Bracelet Length	10–11 cm
    Extension Chain	3.5 cm
    How to Find Your Size
    Bangles & Rings: Take a bangle or ring that fits you comfortably and measure the inner diameter using a ruler. Match it with the size guide above.
    
    Bracelets: Measure your wrist just above the wrist bone and choose the size range that feels most comfortable.
    
    Need help choosing the right size? Contact us on Instagram and we’ll be happy to assist you., remove title style it will take defalt styles
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-size-guide-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 36px 24px;
    color: #514337;
    background: #ffffff;
    border: 1px solid #ded6cf;
    border-radius: 8px;
    box-sizing: border-box;
  }

  .ai-size-guide-{{ ai_gen_id }}__inner { max-width: 900px; margin: 0 auto; }
  .ai-size-guide-{{ ai_gen_id }}__header { margin-bottom: 30px; }
  .ai-size-guide-{{ ai_gen_id }}__intro { color: #5c5148; font-size: 16px; line-height: 1.6; margin: 0; }
  .ai-size-guide-{{ ai_gen_id }}__content h2 { color: #514337; font-size: 21px; line-height: 1.3; margin: 28px 0 12px; }
  .ai-size-guide-{{ ai_gen_id }}__content h3 { color: #514337; font-size: 17px; line-height: 1.35; margin: 20px 0 8px; }
  .ai-size-guide-{{ ai_gen_id }}__content p { color: #5c5148; line-height: 1.65; margin: 10px 0; }
  .ai-size-guide-{{ ai_gen_id }}__content table { width: 100%; border-collapse: collapse; margin: 0 0 18px; font-size: 15px; }
  .ai-size-guide-{{ ai_gen_id }}__content th, .ai-size-guide-{{ ai_gen_id }}__content td { padding: 12px 14px; border: 1px solid #ded6cf; text-align: left; vertical-align: top; }
  .ai-size-guide-{{ ai_gen_id }}__content th { background: #f9f8f6; color: #514337; font-weight: 600; }
  .ai-size-guide-{{ ai_gen_id }}__content td { color: #5c5148; }
  .ai-size-guide-{{ ai_gen_id }}__contact { margin-top: 26px; padding-top: 20px; border-top: 1px solid #ded6cf; color: #514337; line-height: 1.6; }
  .ai-size-guide-{{ ai_gen_id }}__contact a { color: #514337; font-weight: 600; text-underline-offset: 3px; }
  .ai-size-guide-{{ ai_gen_id }}__contact a:focus-visible { outline: 2px solid #514337; outline-offset: 3px; }
  @media screen and (max-width: 600px) {
    .ai-size-guide-{{ ai_gen_id }} { padding: 26px 16px; }
    .ai-size-guide-{{ ai_gen_id }}__content th, .ai-size-guide-{{ ai_gen_id }}__content td { padding: 10px; font-size: 14px; }
  }
{% endstyle %}

<div class="ai-size-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-size-guide-{{ ai_gen_id }}__inner">
    <header class="ai-size-guide-{{ ai_gen_id }}__header">
      <p class="ai-size-guide-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>
    </header>
    <div class="ai-size-guide-{{ ai_gen_id }}__content">
      <h2>Bangles</h2>
      <table><thead><tr><th scope="col">Size</th><th scope="col">Recommended fit</th></tr></thead><tbody><tr><td>2.2</td><td>Thin / Slim Wrists</td></tr><tr><td>2.4</td><td>Medium Wrists</td></tr><tr><td>2.6</td><td>Standard / Regular Fit</td></tr><tr><td>2.8</td><td>Broader / Larger Wrists</td></tr></tbody></table>
      <h2>Rings</h2>
      <table><thead><tr><th scope="col">Size</th><th scope="col">Recommended fit</th></tr></thead><tbody><tr><td>6</td><td>Slimmer Fingers</td></tr><tr><td>7</td><td>Medium Fingers</td></tr><tr><td>8</td><td>Broader Fingers</td></tr></tbody></table>
      <p>Some ring designs are adjustable at the back, making them ideal for gifting or if you’re unsure of the exact size.</p>
      <h2>Necklaces</h2>
      <h3>Double Layer Necklace</h3>
      <table><thead><tr><th scope="col">Measurement</th><th scope="col">Length</th></tr></thead><tbody><tr><td>First Layer</td><td>35–38 cm</td></tr><tr><td>Second Layer</td><td>40–45 cm</td></tr><tr><td>Extension Chain</td><td>5 cm</td></tr></tbody></table>
      <h3>Single Layer Necklace</h3>
      <table><thead><tr><th scope="col">Measurement</th><th scope="col">Length</th></tr></thead><tbody><tr><td>Chain Length</td><td>40–44 cm</td></tr><tr><td>Extension Chain</td><td>5 cm</td></tr></tbody></table>
      <h2>Chain Bracelets</h2>
      <h3>Standard Size</h3>
      <table><thead><tr><th scope="col">Measurement</th><th scope="col">Length</th></tr></thead><tbody><tr><td>Bracelet Length</td><td>15–18 cm</td></tr><tr><td>Extension Chain</td><td>3.5 cm</td></tr></tbody></table>
      <h3>Kids Size</h3>
      <table><thead><tr><th scope="col">Measurement</th><th scope="col">Length</th></tr></thead><tbody><tr><td>Bracelet Length</td><td>10–11 cm</td></tr><tr><td>Extension Chain</td><td>3.5 cm</td></tr></tbody></table>
      <h2>How to Find Your Size</h2>
      <p><strong>Bangles &amp; Rings:</strong> Take a bangle or ring that fits you comfortably and measure the inner diameter using a ruler. Match it with the size guide above.</p>
      <p><strong>Bracelets:</strong> Measure your wrist just above the wrist bone and choose the size range that feels most comfortable.</p>
    </div>
    <div class="ai-size-guide-{{ ai_gen_id }}__contact">
      {{ block.settings.contact_text | escape }}
      {% if block.settings.instagram_link != blank %}<a href="{{ block.settings.instagram_link }}" target="_blank" rel="noopener noreferrer">{{ block.settings.contact_link_label | escape }}</a>{% else %}<span>{{ block.settings.contact_link_label | escape }}</span>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Size guide",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "intro", "label": "Introduction", "default": "Find your perfect fit with our sizing chart." },
    { "type": "text", "id": "contact_text", "label": "Contact message", "default": "Need help choosing the right size? Contact us on Instagram and we’ll be happy to assist you." },
    { "type": "text", "id": "contact_link_label", "label": "Instagram link text", "default": "Visit our Instagram" },
    { "type": "url", "id": "instagram_link", "label": "Instagram link" }
  ],
  "presets": [{ "name": "Size guide" }],
  "tag": null,
  "class": "size-guide-block"
}
{% endschema %}